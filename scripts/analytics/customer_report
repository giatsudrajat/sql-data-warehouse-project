/*
===============================================================================
Customer Report
===============================================================================

Purpose:
    Generate a customer-level sales report containing:
    - Customer demographics
    - Customer segmentation
    - Recency
    - Order and sales metrics
    - Customer lifespan
    - Average order value
    - Average monthly spend

Final Grain:
    One row per customer_key.

Database:
    Microsoft SQL Server / T-SQL

Business Assumptions:
    - order_number uniquely identifies a business order.
    - fact_sales may contain multiple rows per order.
    - Sales records are retained even when no matching customer dimension
      record exists.
    - lifespan_months is inclusive, so activity within one calendar month
      produces a lifespan of 1 month.
===============================================================================
*/

-- ============================================================================
-- Create Report: gold.report_customer
-- ============================================================================

CREATE OR ALTER VIEW gold.report_customer
AS

WITH sales_base AS
(
/*-----------------------------------------------------------------------------
1) Base Query: Retrieve sales activity and customer attributes
-----------------------------------------------------------------------------*/
    SELECT
        fs.order_number,
        fs.product_key,
        fs.order_date,
        fs.sales_amount,
        fs.quantity,

        -- Use the fact-side key so unmatched sales remain independently grouped.
        fs.customer_key,

        c.customer_number,
        CONCAT(c.first_name, ' ', c.last_name) AS customer_name,

        -- Calculate completed age instead of only counting year boundaries.
        DATEDIFF(YEAR, c.birthdate, GETDATE())
        - CASE
            WHEN DATEADD(
                    YEAR,
                    DATEDIFF(YEAR, c.birthdate, GETDATE()),
                    c.birthdate
                ) > GETDATE()
                THEN 1
            ELSE 0
          END AS age

    FROM gold.fact_sales AS fs
    LEFT JOIN gold.dim_customers AS c
        ON c.customer_key = fs.customer_key

    -- Exclude sales rows without a valid order date from customer metrics.
    WHERE fs.order_date IS NOT NULL
),

customer_aggregation AS
(
/*-----------------------------------------------------------------------------
2) Customer Aggregation: Summarize metrics at customer grain
-----------------------------------------------------------------------------*/
    SELECT
        customer_key,
        customer_number,
        customer_name,
        age,

        -- Prevent order-line grain from inflating the order count.
        COUNT(DISTINCT order_number) AS total_orders,

        SUM(sales_amount) AS total_sales,
        SUM(quantity) AS total_quantity,
        COUNT(DISTINCT product_key) AS total_products,

        MAX(order_date) AS last_order_date,

        -- Inclusive span of customer activity in calendar months.
        DATEDIFF(
            MONTH,
            MIN(order_date),
            MAX(order_date)
        ) + 1 AS lifespan_months

    FROM sales_base

    GROUP BY
        customer_key,
        customer_number,
        customer_name,
        age
)

/*-----------------------------------------------------------------------------
3) Final Report: Add customer classifications and derived KPIs
-----------------------------------------------------------------------------*/
SELECT
    customer_key,
    customer_number,
    customer_name,
    age,

    -- Customer demographic age band.
    CASE
        WHEN age IS NULL THEN 'Unknown'
        WHEN age < 20 THEN 'Under 20'
        WHEN age BETWEEN 20 AND 29 THEN '20-29'
        WHEN age BETWEEN 30 AND 39 THEN '30-39'
        WHEN age BETWEEN 40 AND 49 THEN '40-49'
        ELSE '50 and above'
    END AS age_group,

    -- Customer segment based on lifespan and total sales.
    CASE
        WHEN lifespan_months >= 12
             AND total_sales > 5000
            THEN 'VIP'

        WHEN lifespan_months >= 12
             AND total_sales <= 5000
            THEN 'Regular'

        WHEN lifespan_months < 12
             AND total_sales > 10000
            THEN 'Great'

        ELSE 'New'
    END AS customer_segment,

    last_order_date,

    -- Number of calendar month boundaries since the latest order.
    DATEDIFF(
        MONTH,
        last_order_date,
        GETDATE()
    ) AS recency_months,

    total_orders,
    total_sales,
    total_quantity,
    total_products,
    lifespan_months,

    -- Average revenue generated per distinct order.
    COALESCE(
        total_sales / NULLIF(total_orders, 0),
        0
    ) AS average_order_value,

    -- Average sales generated per active customer month.
    COALESCE(
        total_sales / NULLIF(lifespan_months, 0),
        0
    ) AS average_monthly_spend

FROM customer_aggregation;
GO
